# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/waste_detection
# Pour développement SQLite:
# DATABASE_URL=sqlite:///waste_detection.db

# Redis (pour Celery)
REDIS_URL=redis://localhost:6379/0

# OpenAI (pour AI Agent LangChain)
OPENAI_API_KEY=your-openai-api-key

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@wastedetection.com

# Twilio (SMS Alerts - optionnel)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Model Configuration
MODEL_PATH=../ml-training/outputs/best_model.pth
MODEL_TYPE=onnx  # ou pytorch
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.4

# API Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,mp4,avi

# Sentry (Monitoring - optionnel)
SENTRY_DSN=your-sentry-dsn

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
